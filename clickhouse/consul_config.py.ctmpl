{{- define "KEY" -}}
    {{ keyOrDefault (printf "docker-server-configs/LB/config.%s.json/%s" (env "DEPLOY_ENV") .)  (printf "KEYDOESNOTEXIST_%s" .) }}
{{- end -}}

# Put everything after the defines otherwise the rendered config might eat up some newlines

# ClickHouse connection settings
{{if service "clickhouse-listenbrainz"}}
{{with index (service "clickhouse-listenbrainz") 0}}
CLICKHOUSE_HOST = "{{.Address}}"
CLICKHOUSE_PORT = {{.Port}}
{{end}}
{{else}}
CLICKHOUSE_HOST = "SERVICEDOESNOTEXIST_clickhouse-listenbrainz"
CLICKHOUSE_PORT = "SERVICEDOESNOTEXIST_clickhouse-listenbrainz"
{{end}}
CLICKHOUSE_DATABASE = '''{{ keyOrDefault (printf "docker-server-configs/LB/config.%s.json/clickhouse_database" (env "DEPLOY_ENV")) "default" }}'''
CLICKHOUSE_USERNAME = '''{{ keyOrDefault (printf "docker-server-configs/LB/config.%s.json/clickhouse_username" (env "DEPLOY_ENV")) "default" }}'''
CLICKHOUSE_PASSWORD = '''{{ keyOrDefault (printf "docker-server-configs/LB/config.%s.json/clickhouse_password" (env "DEPLOY_ENV")) "" }}'''

# RabbitMQ connection settings
{{- $rabbitmq_services := service "rabbitmq-listenbrainz"}}
{{- if $rabbitmq_services}}
RABBITMQ_HOSTS = [
{{- range $rabbitmq_services}}
    ("{{.Address}}", {{.Port}}),
{{- end}}
]
{{else}}
RABBITMQ_HOSTS = [("SERVICEDOESNOTEXIST_rabbitmq-listenbrainz", "SERVICEDOESNOTEXIST_rabbitmq-listenbrainz")]
{{end}}
RABBITMQ_USERNAME = '''{{template "KEY" "rabbitmq_user"}}'''
RABBITMQ_PASSWORD = '''{{template "KEY" "rabbitmq_pass"}}'''
RABBITMQ_VHOST = '''{{template "KEY" "rabbitmq_vhost"}}'''

# RabbitMQ exchanges and queues for ClickHouse operations
CLICKHOUSE_EXCHANGE = '''{{ keyOrDefault (printf "docker-server-configs/LB/config.%s.json/clickhouse_exchange" (env "DEPLOY_ENV")) "clickhouse" }}'''
CLICKHOUSE_QUEUE = '''{{ keyOrDefault (printf "docker-server-configs/LB/config.%s.json/clickhouse_queue" (env "DEPLOY_ENV")) "clickhouse" }}'''
CLICKHOUSE_RESULT_EXCHANGE = '''{{ keyOrDefault (printf "docker-server-configs/LB/config.%s.json/clickhouse_result_exchange" (env "DEPLOY_ENV")) "clickhouse_result" }}'''

# ListenBrainz listens database DSN for importing listen deletions
# (listen_delete_metadata and deleted_user_listen_history live only there).
{{if service "pgbouncer-listenbrainz-user-listenstore"}}
{{with index (service "pgbouncer-listenbrainz-user-listenstore") 0}}
LISTENS_DSN = """postgresql://{{template "KEY" "listens_db_user"}}:{{template "KEY" "listens_db_password"}}@{{.Address}}:{{.Port}}/{{template "KEY" "listens_db_name"}}"""
{{end}}
{{else if service "listenbrainz-user-listenstore"}}
{{with index (service "listenbrainz-user-listenstore") 0}}
LISTENS_DSN = """postgresql://{{template "KEY" "listens_db_user"}}:{{template "KEY" "listens_db_password"}}@{{.Address}}:{{.Port}}/{{template "KEY" "listens_db_name"}}"""
{{end}}
{{else}}
LISTENS_DSN = "SERVICEDOESNOTEXIST_listenbrainz-user-listenstore"
{{end}}

# FTP settings for dump download
FTP_SERVER_URI = '''{{ keyOrDefault (printf "docker-server-configs/LB/config.%s.json/ftp_server_uri" (env "DEPLOY_ENV")) "ftp.eu.metabrainz.org" }}'''
FTP_LISTENS_DIR = '''{{ keyOrDefault (printf "docker-server-configs/LB/config.%s.json/ftp_listens_dir" (env "DEPLOY_ENV")) "/pub/musicbrainz/listenbrainz/" }}'''
